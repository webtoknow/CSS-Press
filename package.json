{
  "name": "css-press",
  "homepage": "https://webtoknow.github.io/CSS-Press",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "oxlint --deny-warnings",
    "preview": "vite preview",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "predeploy": "tsc && vite build --base=/CSS-Press/",
    "deploy": "gh-pages -d dist",
    "predeploy:test": "tsc && vite build --base=/cs-test/",
    "deploy:test": "gh-pages -d dist -r git@github.com:webtoknow/cs-test.git"
  },
  "dependencies": {
    "@xstate/react": "^6.1.0",
    "animate.css": "^4.1.1",
    "html-react-parser": "^6.1.9",
    "normalize.css": "8.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "style-it": "^2.1.4",
    "xstate": "^5.33.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitest/coverage-v8": "^5.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.93.0",
    "puppeteer": "^25.17.0",
    "sass": "^1.108.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.1.0"
  }
}
